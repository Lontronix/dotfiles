# Setting up PATH...
export PATH="/opt/homebrew/bin:$PATH"
export PATH="/opt/homebrew/opt/ruby/bin:/opt/homebrew/lib/ruby/gems/4.0.0/bin:$PATH"

# Welcome message
neofetch

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time oh-my-zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="powerlevel10k/powerlevel10k"

zstyle ':omz:update' mode reminder  # just remind me to update when it's time

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
plugins=(git)

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

source $ZSH/oh-my-zsh.sh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

{{ if not .server }}
export EDITOR="nova --wait"
{{ end }}

# User defined aliases
source ~/.zsh_aliases

[[ -f "$HOME/.zsh_secrets" ]] && source "$HOME/.zsh_secrets"

# Enables Vim Keybindindings
bindkey -v

{{ if .work }}
# wt (https://worktrunk.dev) init
if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

# wtc — create a git worktree via an interactive Claude session, then cd into it.
# Pass a Jira/Linear link, a bare ticket key, a branch name, or a name for a new
# branch. Claude runs the manage-worktrees skill (asks you to confirm the
# name/branch type), and on exit this drops your shell into the new worktree.
# The plumbing: WT_CD_FILE is inherited by Claude's shell; wt.sh writes the
# resolved worktree path there; a subprocess can't cd the parent, so the cd
# lives here.
wtc() {
  emulate -L zsh
  if (( $# == 0 )); then
    print -u2 "usage: wtc <ticket-url | ticket-key | branch | name>"
    return 1
  fi
  local cd_file dest=""
  cd_file="$(mktemp "${TMPDIR:-/tmp}/wt-cd.XXXXXX")" || return 1
  WT_CD_FILE="$cd_file" claude "Use the manage-worktrees skill to create a git worktree for: $*"
  [[ -s "$cd_file" ]] && dest="$(<"$cd_file")"
  rm -f "$cd_file"
  if [[ -n "$dest" && -d "$dest" ]]; then
    cd "$dest" && print "→ $PWD"
  else
    print -u2 "wtc: no worktree path was recorded; staying in $PWD"
    return 1
  fi
}

# tticket — open the Jira ticket referenced in the current git branch.
# Extracts a ticket key from the branch name (e.g. NBS-1724, MOBILE-3170) and
# opens it in the browser. Prints an error if the branch has no obvious ticket id.
tticket() {
  emulate -L zsh
  local branch key seg
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
  if [[ -z "$branch" ]]; then
    print -u2 "tticket: not inside a git repository"
    return 1
  fi

  # Prefer an UPPERCASE key anywhere in the branch (NBS-1724, ...-NBS-1229).
  key="$(print -r -- "$branch" | grep -oE '[A-Z]{2,}-[0-9]+' | head -n1)"

  # Fall back to a lowercase key that is a whole "/"-delimited segment (nbs-1773).
  if [[ -z "$key" ]]; then
    for seg in ${(s:/:)branch}; do
      if [[ "$seg" =~ '^[A-Za-z]{2,}-[0-9]+$' ]]; then
        key="${(U)seg}"
        break
      fi
    done
  fi

  if [[ -z "$key" ]]; then
    print -u2 "tticket: no Jira ticket id found in branch '$branch'"
    return 1
  fi

  local url="https://fetchrewards.atlassian.net/browse/$key"
  print "Opening $url"
  open "$url"
}
{{ end -}}

[[ -f "$HOME/fig-export/dotfiles/dotfile.zsh" ]] && builtin source "$HOME/fig-export/dotfiles/dotfile.zsh"

